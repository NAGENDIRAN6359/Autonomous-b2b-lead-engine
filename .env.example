# ============================================================
#  B2B Lead Nurturing & Booking Engine — Environment Variables
#  Copy this file to .env and fill in every value before running
# ============================================================

# --------------------------
# SERVER
# --------------------------
PORT=3000
NODE_ENV=development

# Shared secret used to verify incoming webhook signatures
WEBHOOK_SECRET=your_webhook_shared_secret_here

# --------------------------
# OPENAI
# --------------------------
OPENAI_API_KEY=sk-...
# Model to use for qualification + email drafting
OPENAI_MODEL=gpt-4o
# Max tokens for email generation
OPENAI_MAX_TOKENS=800

# --------------------------
# VAPI (Voice AI)
# --------------------------
VAPI_API_KEY=your_vapi_api_key_here
# The Vapi assistant ID configured for outbound lead calls
VAPI_ASSISTANT_ID=your_vapi_assistant_id_here
# Delay in minutes before the AI call is placed after lead qualification
VAPI_CALL_DELAY_MINUTES=15
# Your company phone number (E.164 format, e.g. +12025551234)
VAPI_FROM_PHONE_NUMBER=+1XXXXXXXXXX

# --------------------------
# GOOGLE OAUTH 2.0
# (Gmail + Google Calendar)
# --------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Refresh token obtained after first OAuth consent flow
GOOGLE_REFRESH_TOKEN=your_google_refresh_token

# Gmail address to send outreach emails FROM
GMAIL_SENDER_ADDRESS=you@yourcompany.com
GMAIL_SENDER_NAME=Your Name

# Google Calendar ID to create booking slots on
GOOGLE_CALENDAR_ID=primary

# Default meeting duration in minutes
CALENDAR_MEETING_DURATION_MINUTES=30

# Booking page URL (Calendly or custom) included in emails/calls
BOOKING_PAGE_URL=https://calendly.com/yourname/30min

# --------------------------
# HUBSPOT CRM
# (use either HubSpot or GoHighLevel — leave the other blank)
# --------------------------
HUBSPOT_API_KEY=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# HubSpot pipeline ID for leads
HUBSPOT_PIPELINE_ID=default
# HubSpot deal stage IDs — find in CRM > Settings > Pipelines
HUBSPOT_STAGE_NEW_LEAD=appointmentscheduled
HUBSPOT_STAGE_QUALIFIED=qualifiedtobuy
HUBSPOT_STAGE_OUTREACH_SENT=presentationscheduled
HUBSPOT_STAGE_CALL_SCHEDULED=decisionmakerboughtin
HUBSPOT_STAGE_MEETING_BOOKED=contractsent
HUBSPOT_STAGE_DISQUALIFIED=closedlost

# --------------------------
# GOHIGHLEVEL CRM (alternative to HubSpot)
# --------------------------
GHL_API_KEY=your_gohighlevel_api_key_here
GHL_LOCATION_ID=your_ghl_location_id_here
GHL_PIPELINE_ID=your_ghl_pipeline_id_here
# GoHighLevel stage IDs
GHL_STAGE_NEW_LEAD=new-lead
GHL_STAGE_QUALIFIED=qualified
GHL_STAGE_OUTREACH_SENT=outreach-sent
GHL_STAGE_CALL_SCHEDULED=call-scheduled
GHL_STAGE_MEETING_BOOKED=meeting-booked
GHL_STAGE_DISQUALIFIED=disqualified

# Which CRM to use: "hubspot" or "gohighlevel"
CRM_PROVIDER=hubspot

# --------------------------
# N8N (optional — if triggering n8n from code)
# --------------------------
N8N_BASE_URL=https://your-n8n-instance.com
N8N_WEBHOOK_PATH=/webhook/lead-intake
N8N_API_KEY=your_n8n_api_key_here

# --------------------------
# LEAD QUALIFICATION THRESHOLDS
# --------------------------
# Minimum ICP score to trigger email outreach (0–100)
QUALIFICATION_HOT_THRESHOLD=80
# Minimum ICP score to trigger nurture sequence (0–100)
QUALIFICATION_WARM_THRESHOLD=50

# --------------------------
# YOUR COMPANY (used in email/call personalization)
# --------------------------
COMPANY_NAME=Your Company Name
COMPANY_WEBSITE=https://yourcompany.com
COMPANY_VALUE_PROP=We help B2B companies automate lead generation and close more deals.
TARGET_INDUSTRIES=SaaS,E-commerce,Professional Services,Finance
